node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
.dcp/*
!.dcp/codex.yaml
!.dcp/codex.lock
# Nested .dcp dirs (vault ledger, WAL, audit) hold live state, never committed.
# Excluding the directory itself, which "**/.dcp/" would also do to the root one,
# stops git descending into it and would defeat the negations above.
**/*/.dcp/
